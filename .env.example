# === LLM（智谱 GLM 的 Anthropic 兼容端点）===
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_AUTH_TOKEN=
LLM_MODEL=glm-4.6

# === 仓库根（代码任务在其下建 worktree）===
REPO_ROOT=./repos

# === 记忆目录 ===
MEMORY_DIR=./data/memory

# === SQLite 数据库 ===
DB_PATH=./data/donger.db

# === 钉钉企业自建应用（M3 启用）===
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_CODE=
# AI 卡片模板 ID（钉钉开发者后台创建卡片模板后填入；有则用 AI 卡片流式回复，无则用文本消息）
DINGTALK_CARD_TEMPLATE_ID=

# === 服务端口（控制 API / webhook 兜底）===
PORT=3000

# === 日志级别（debug/info/warn/error）===
LOG_LEVEL=info

# === 管理员（钉钉 staffId，逗号分隔；首次消息自动创建为 admin）===
ADMIN_STAFF_IDS=

# === superpowers 插件（编码能力来源，M2 启用）===
# 指向 superpowers 插件根目录（含 .claude-plugin/plugin.json），例：
# ~/.claude/plugins/cache/claude-plugins-official/superpowers/<version>
SUPERPOWERS_PLUGIN_PATH=
