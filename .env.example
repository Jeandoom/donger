# === LLM（智谱 GLM 的 Anthropic 兼容端点）===
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_AUTH_TOKEN=
LLM_MODEL=glm-4.6

# === 仓库根（代码任务在其下建 worktree）===
REPO_ROOT=./repos

# === 记忆目录 ===
MEMORY_DIR=./data/memory

# === SQLite 数据库 ===
DB_PATH=./data/donger.db

# === 钉钉企业自建应用（M3 启用）===
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_CODE=
# AI 卡片模板 ID（钉钉开发者后台创建卡片模板后填入；有则用 AI 卡片流式回复，无则用文本消息）
DINGTALK_CARD_TEMPLATE_ID=

# === 服务端口 ===
# PORT     后端服务端口（控制 API / SSE / 静态托管，默认 3330）
# HOST     监听地址（0.0.0.0=全网卡可外部访问，127.0.0.1=仅本机，默认 0.0.0.0）
# WEB_PORT 前端 Vite dev 端口（仅开发期，默认 3333）；生产期前端由后端 PORT 托管
PORT=3330
HOST=0.0.0.0
WEB_PORT=3333

# === HTTPS（证书与私钥不得提交；建议放在已忽略的 .data/）===
# HTTPS_CERT_PATH 与 HTTPS_KEY_PATH 必须同时填写；HTTPS_CHAIN_PATH 可选。
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
HTTPS_CHAIN_PATH=

# === 日志级别（debug/info/warn/error）===
LOG_LEVEL=info

# === 管理员（钉钉 staffId，逗号分隔；首次消息自动创建为 admin）===
ADMIN_STAFF_IDS=

# === CLI 前端登录共享密钥 ===
# 非空时启用 POST /api/auth/exchange：CLI 用此密钥换 JWT 登录（用户 internal/cli-admin）。
# 需要 CLI 具备管理员权限时，把 cli-admin 加入 ADMIN_EXTERNAL_IDS。
CLI_TOKEN=

# === 预装技能根目录（其下每个子目录 = 一个预装 Pack）===
# 默认 <repoRoot>/skills。把 superpowers 等内置技能放入 skills/<pack>/ 即自动预装给每个用户。
# 例：BUILTIN_SKILLS_DIR=~/.claude/plugins/cache/claude-plugins-official/superpowers/5.1.0
BUILTIN_SKILLS_DIR=

# === Agent 密钥主密钥（MCP env/headers 加密用）；缺省从 JWT_SECRET 派生 ===
SECRET_KEY=

# === Agent 可选 LLM 预置模型，格式 name|model|baseUrl，多条用 ; 分隔 ===
AGENT_LLM_PRESETS=

# === Git 平台授权 ===
# 有固定外部访问地址时填写，钉钉与 Git OAuth callback 均优先使用；未配置时回退到 HOST。
PUBLIC_BASE_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=
JIHULAB_CLIENT_ID=
JIHULAB_CLIENT_SECRET=
# 单仓库 Git 操作超时与权限校验缓存时间（毫秒）
GIT_CLONE_TIMEOUT_MS=120000
GIT_AUTH_CACHE_TTL_MS=600000
