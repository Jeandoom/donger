# === LLM（智谱 GLM 的 Anthropic 兼容端点）===
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_AUTH_TOKEN=
LLM_MODEL=glm-4.6

# === 仓库根（代码任务在其下建 worktree）===
REPO_ROOT=./repos

# === 记忆目录 ===
MEMORY_DIR=./data/memory

# === SQLite 数据库 ===
DB_PATH=./data/donger.db

# === 钉钉企业自建应用（M3 启用）===
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_CODE=

# === 服务端口（控制 API / webhook 兜底）===
PORT=3000

# === 日志级别（debug/info/warn/error）===
LOG_LEVEL=info
