# === LLM（智谱 GLM 的 Anthropic 兼容端点）===
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_AUTH_TOKEN=
LLM_MODEL=glm-4.6

# === 仓库根（代码任务在其下建 worktree）===
REPO_ROOT=./repos

# === 记忆目录 ===
MEMORY_DIR=./data/memory

# === SQLite 数据库 ===
DB_PATH=./data/donger.db

# === 钉钉企业自建应用（M3 启用）===
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_CODE=
# AI 卡片模板 ID（钉钉开发者后台创建卡片模板后填入；有则用 AI 卡片流式回复，无则用文本消息）
DINGTALK_CARD_TEMPLATE_ID=
# 钉钉扫码登录回调地址（完整 URL，须与钉钉开放平台应用注册的重定向 URI 完全一致；
# 留空则按 PUBLIC_BASE_URL → HOST:PORT 逐级推导）
DINGTALK_LOGIN_REDIRECT_URI=

# === GitHub OAuth 登录（可选；CLIENT_ID 与 CLIENT_SECRET 均非空才启用）===
# 在 https://github.com/settings/developers 建 OAuth App，Authorization callback URL 填
# <公网地址>/api/auth/github/callback（如 https://example.com:3330/api/auth/github/callback）。
# dev（localhost）与生产域名不同时需分别建 App，dev 在此用 GITHUB_LOGIN_REDIRECT_URI 覆盖。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub 登录回调地址（完整 URL；留空则按 PUBLIC_BASE_URL → HOST:PORT 逐级推导）
GITHUB_LOGIN_REDIRECT_URI=
# GitHub 请求代理（如 http://127.0.0.1:7897；大陆网络直连 github.com 间歇超时时配置。
# 留空=直连。仅作用于 GitHub OAuth 请求，代理失败自动回退直连）
GITHUB_OAUTH_PROXY=

# === 服务端口 ===
# PORT     后端服务端口（控制 API / SSE / 静态托管，默认 3330）
# HOST     监听地址（0.0.0.0=全网卡可外部访问，127.0.0.1=仅本机，默认 0.0.0.0）
# WEB_PORT 前端 Vite dev 端口（仅开发期，默认 3333）；生产期前端由后端 PORT 托管
PORT=3330
HOST=0.0.0.0
WEB_PORT=3333

# === HTTPS（证书与私钥不得提交；建议放在已忽略的 .data/）===
# HTTPS_CERT_PATH 与 HTTPS_KEY_PATH 必须同时填写；HTTPS_CHAIN_PATH 可选。
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
HTTPS_CHAIN_PATH=

# === 日志级别（debug/info/warn/error）===
LOG_LEVEL=info

# === 管理员 ===
# 外部 ID 白名单（逗号分隔；裸 externalId 对全平台生效，或 provider:externalId 限定平台，如 github:12345678）
ADMIN_EXTERNAL_IDS=
# 已废弃：保留兼容，值会合并进 ADMIN_EXTERNAL_IDS
ADMIN_STAFF_IDS=

# === CLI 前端登录共享密钥 ===
# 非空时启用 POST /api/auth/exchange：CLI 用此密钥换 JWT 登录（用户 internal/cli-admin）。
# 需要 CLI 具备管理员权限时，把 cli-admin 加入 ADMIN_EXTERNAL_IDS。
CLI_TOKEN=

# === 预装技能根目录（其下每个子目录 = 一个预装 Pack）===
# 默认 <repoRoot>/skills。把 superpowers 等内置技能放入 skills/<pack>/ 即自动预装给每个用户。
# 例：BUILTIN_SKILLS_DIR=~/.claude/plugins/cache/claude-plugins-official/superpowers/5.1.0
BUILTIN_SKILLS_DIR=

# === Agent 密钥主密钥（MCP env/headers 加密用）；缺省从 JWT_SECRET 派生 ===
SECRET_KEY=

# === Agent 可选 LLM 预置模型，格式 name|model|baseUrl，多条用 ; 分隔 ===
AGENT_LLM_PRESETS=

# === Git 平台授权 ===
# 有固定外部访问地址时填写，钉钉与 Git OAuth callback 均优先使用；未配置时回退到 HOST。
PUBLIC_BASE_URL=
# 单仓库 Git 操作超时与权限校验缓存时间（毫秒）
GIT_CLONE_TIMEOUT_MS=120000
GIT_AUTH_CACHE_TTL_MS=600000

# === 智能体回调链接 ===
# 回调发起限流（次/分钟/token；防链接泄露后被刷 LLM 费用）
CALLBACK_RATE_LIMIT_PER_MIN=10

# === 会话执行健壮性 ===
# LLM 流停摆看门狗：单轮超过该毫秒数无任何事件视为挂死，中断并立即收尾（0=关闭）
TURN_STALL_TIMEOUT_MS=600000
# 会话空闲滚动：距最后活跃超过该小时数的会话重开新 SDK 会话，防止每轮全量重建超长上下文（0=关闭）
SESSION_IDLE_ROLL_HOURS=168
